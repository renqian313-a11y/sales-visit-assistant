# ====== 复制本文件为 .env 并填入你的密钥 ======

# 服务端口
PORT=4100

# —— 大模型（OpenRouter）——
# 注册 https://openrouter.ai 后在 Keys 页面创建
OPENROUTER_API_KEY=
# 用哪个模型，便宜首选 deepseek/deepseek-chat；质量更高可换 openai/gpt-4o
OPENROUTER_MODEL=deepseek/deepseek-chat

# —— 语音转写（Groq Whisper，普通话够用）——
# 注册 https://console.groq.com 后创建 API Key
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3

# —— 声纹分说话人（CAM++ ONNX，中文）——
# 模型不随仓库提交，首次需下载到 models/（约 27MB，Apache-2.0）：
#   mkdir -p models && curl -L -o models/campplus_zh.onnx \
#     https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
# 模型缺失时自动回退：实时按男女声、定稿按时长封顶（零报错）。
# SPEAKER_MODEL_PATH=models/campplus_zh.onnx   # 默认即此路径，一般不用填
MAX_SPEAKERS=2                                  # 说话人数封顶（默认2=BD+商家；多人门店可调大）
# 以下阈值一般不用改，需在真实录音上微调时再开：
# SPEAKER_SIM=0.55           # 实时：与质心相似度≥此值判为同一人
# SPEAKER_NEW_DUR_MS=1500    # 实时：短于此的句子不许开新说话人（防过分裂）
# SPEAKER_MIN_EMB_MS=700     # 短于此的音频不出声纹（沿用上一说话人）
# SPEAKER_MERGE_SIM=0.70     # 定稿：合并两个 Deepgram 说话人的相似度门槛
# SPEAKER_MIN_CLUSTER_MS=3000 # 定稿：小于此时长的簇并入最近的人
